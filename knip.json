{
  "$schema": "https://unpkg.com/knip@6.48.0/schema.json",
  "entry": [
    "bin/plangraph",
    "src/cli.ts",
    "mcp/plangraph-mcp.ts",
    "scripts/*.ts",
    "evals/*.ts",
    // the live pilot driver, run by hand as documented in docs/BENCHMARK.md
    "evals/ab/pilot.ts",
    "test/**/*.test.{mjs,ts}",
    "test/types-fixtures/*-bad.ts",
    "test/**/*.assure.ts"
  ],
  "ignore": [
    // the frozen runtime of a released version (scripts/freeze-release.ts): run by the mixed-version tests, never imported
    "test/fixtures/release-*/**"
  ],
  "ignoreFiles": [
    // a template for the Claude Code Workflow tool, run by that tool and never imported by the plugin
    "workflows/audit.workflow.js"
  ],
  "ignoreBinaries": [
    // optional runtime for the Python solver: `plangraph doctor` probes for it and plangraph-solve-run falls back to a venv without it
    "uv",
    // system tool for npm run lint:sh (installed from its release tarball in CI, the developer's own locally); the lint script and its test skip with a notice without it
    "shellcheck"
  ]
}
