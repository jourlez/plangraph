{
  "name": "plangraph",
  "version": "0.5.0",
  "description": "Planning memory for AI coding agents: a dependency graph in git text, safe reassignment, provable schedules, token-minimal answers.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "jourlez",
  "keywords": ["planning", "jira", "knowledge-graph", "memory", "scheduling"],
  "packageManager": "npm@12.2.3",
  "engines": {
    "node": ">=24.15"
  },
  "bin": {
    "plangraph": "bin/plangraph"
  },
  "scripts": {
    "test": "node --test $(node scripts/ci-tests.ts nontiming) && node --test --test-concurrency=1 $(node scripts/ci-tests.ts timing)",
    "smoke": "bash test/smoke.sh",
    "bench": "node test/bench-tokens.ts",
    "validate:plugin": "node test/validate-plugin.ts",
    "validate": "npm run lint:check && npm run typecheck && npm run test:coverage && npm run assure && npm run validate:plugin && npm run knip && npm run lint:sh && npm audit --audit-level=high",
    "test:coverage": "node scripts/test-coverage.ts",
    "test:watch": "node --test --watch \"test/*.test.{mjs,ts}\"",
    "mutate": "node scripts/mutate.ts",
    "assure": "node --test \"test/assure/*.test.{mjs,ts}\"",
    "mutate:all": "node scripts/mutate-all.ts --jobs 4",
    "mutate:smoke": "node scripts/mutate-all.ts --files lib/verify.ts,lib/whatif.ts,lib/gitsafe.ts,lib/fsafe.ts,lib/forecast.ts,lib/report.ts --limit 40 --seed 1 --max-tier 1 --jobs 2",

    "typecheck": "node scripts/typecheck.ts",
    "lint": "biome check --write .",
    "lint:check": "biome check .",
    "lint:fix": "biome check --write .",
    "test:related": "node scripts/related-tests.ts",
    "bulletproof": "npm run lint:fix && npm run typecheck && npm run test",
    "bulletproof:check": "npm run lint:check && npm run typecheck && npm run test",
    "knip": "knip",
    "lint:sh": "node scripts/lint-sh.ts",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "24.19.2",
    "knip": "6.48.0",
    "lefthook": "2.2.2",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jourlez/plangraph.git"
  },
  "homepage": "https://github.com/jourlez/plangraph",
  "bugs": {
    "url": "https://github.com/jourlez/plangraph/issues"
  }
}
