{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"formatter": { "enabled": false },
	"assist": { "enabled": false },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"useTemplate": "off",
				"useConst": "error",
				"useImportType": "error",
				"useExportType": "error"
			},
			"complexity": {
				"useOptionalChain": "off",
				"noCommaOperator": "off",
				"noUselessEscapeInRegex": "off"
			},
			"correctness": {
				"noUnusedFunctionParameters": "off",
				"noUnusedVariables": "error",
				"noUnusedImports": "error"
			},
			"suspicious": {
				"noVar": "error",
				"noDoubleEquals": "error",
				"noAssignInExpressions": "off",
				"noControlCharactersInRegex": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["lib/sanitize.ts"],
			"linter": {
				"rules": { "suspicious": { "noMisleadingCharacterClass": "off" } }
			}
		},
		{
			"includes": ["test/jira.test.ts"],
			"linter": { "rules": { "correctness": { "noPrecisionLoss": "off" } } }
		},
		{
			"includes": ["test/**/*.ts", "evals/**/*.ts", "scripts/baseline.ts"],
			"linter": {
				"rules": { "suspicious": { "noTemplateCurlyInString": "off" } }
			}
		}
	],
	"files": {
		"includes": [
			"lib/**/*.ts",
			"src/**/*.ts",
			"src/**/*.js",
			"mcp/*.ts",
			"scripts/**/*.ts",
			"test/**/*.ts",
			"evals/**/*.ts",
			"!test/types-fixtures",
			"!test/fixtures/release-*"
		]
	}
}
