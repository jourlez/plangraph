{
  "$schema": "brain-eval-case/1",
  "id": "trig-reporting-yes",
  "kind": "trigger",
  "tags": [
    "trigger",
    "should-trigger",
    "reporting"
  ],
  "fixture": {
    "size": "M",
    "seed": 7
  },
  "prompt": "Publish the plan status for the stakeholders.",
  "limits": {
    "max_turns": 8,
    "timeout_s": 180,
    "max_usd": 0.3
  },
  "expected": {
    "trigger": true,
    "job": "reporting"
  },
  "graders": [
    {
      "id": "used-brain",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "\\bbrain\\s",
      "min": 1,
      "weight": 3,
      "arm": "with-only"
    },
    {
      "id": "skill-fired",
      "type": "tool_used",
      "tool": "Skill",
      "input_match": "\"skill\"\\s*:\\s*\"(?:[\\w-]+:)?brain(?:-[a-z]+)?\"",
      "min": 1,
      "weight": 1,
      "arm": "with-only"
    }
  ]
}
