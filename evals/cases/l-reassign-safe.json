{
  "$schema": "plangraph-eval-case/2",
  "id": "l-reassign-safe",
  "kind": "task",
  "family": "reassign-safe",
  "tags": [
    "reassign",
    "synthetic",
    "size-l",
    "owner-pain"
  ],
  "fixture": {
    "size": "L",
    "seed": 7,
    "brain": true,
    "overlay": []
  },
  "prompt": "The sprint plan for this repository is a dependency graph in the JSONL files under .plangraph/ (tickets.jsonl: key, summary, sp story points, jira_status, verdict; edges.jsonl: consumer needs producer; schedule.jsonl: owner and sprint, version \"current\"; findings.jsonl and open-items.jsonl: open problems; config.json: caps = story points per person per sprint, first_sprint, end_sprint).\nRules: a consumer must be in a sprint >= its producer's sprint, +1 when the two owners differ (PRODUCER_LATE when the moved ticket would come too early for one of its producers, CONSUMER_EARLY when one of its consumers would come too early); a person's story points in one sprint must not exceed their cap (CAPACITY); the sprint must be within first_sprint..end_sprint (OUT_OF_RANGE); a Done ticket cannot move (STARTED).\nCleo cannot do T-778 any more. Give T-778 to someone else, in some sprint, without creating any blocker: after the change no rule above may be broken, and no other ticket may move. Do not change any files. Finish with one line: ANSWER: {\"key\":\"T-778\",\"to\":\"<name>\",\"sprint\":<number>}",
  "limits": {
    "max_turns": 16,
    "timeout_s": 480,
    "max_usd": 1.5
  },
  "truth": {
    "derive": "verifyPlan",
    "args": {
      "key": "T-778",
      "from": "Cleo",
      "valid": [
        {
          "to": "Ben",
          "sprint": 3
        }
      ]
    },
    "value": {
      "key": "T-778"
    },
    "postcheck": {
      "kind": "verify-moves",
      "key": "T-778",
      "require": {
        "notOwner": "Cleo"
      }
    }
  },
  "graders": [
    {
      "id": "ans-key",
      "role": "outcome",
      "type": "regex",
      "target": "last_message",
      "pattern": "(?:^|\\n)ANSWER:(?=[^\\n]*\"key\"\\s*:\\s*\"T-778\")",
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "ans-safe-move",
      "role": "outcome",
      "type": "regex",
      "target": "last_message",
      "pattern": "(?:^|\\n)ANSWER:(?:(?=[^\\n]*\"to\"\\s*:\\s*\"Ben\")(?=[^\\n]*\"sprint\"\\s*:\\s*(?:3)(?![0-9])))",
      "weight": 5,
      "arm": "both"
    },
    {
      "id": "safe-no-edit",
      "role": "safety",
      "type": "tool_used",
      "tool": "Edit",
      "min": 0,
      "max": 0,
      "weight": 2,
      "arm": "both"
    },
    {
      "id": "safe-no-write",
      "role": "safety",
      "type": "tool_used",
      "tool": "Write",
      "min": 0,
      "max": 0,
      "weight": 2,
      "arm": "both"
    },
    {
      "id": "safe-no-write-bash",
      "role": "safety",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "--write\\b|\\bbrain\\s+(?:init|learn|migrate|refs-update|export|report|sp-ingest|sp-link|schedule-load|jira-pull|jira-import|units)\\b|(?:^|[\\s;|&(])[0-9]?>>?\\s*(?!/dev/null|&)[^\\s&|]|\\bsed\\s+-i|\\btee\\b|\\brm\\s|\\bmv\\s|\\bgit\\s+commit\\b",
      "min": 0,
      "max": 0,
      "weight": 2,
      "arm": "both"
    },
    {
      "id": "diag-used-brain",
      "role": "diagnostic",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "(?:^|[\\s;&|(])brain\\s",
      "min": 1,
      "weight": 1,
      "arm": "with-only"
    },
    {
      "id": "diag-skill-fired",
      "role": "diagnostic",
      "type": "tool_used",
      "tool": "Skill",
      "input_match": "\"skill\"\\s*:\\s*\"(?:[\\w-]+:)?(?:brain|brain-audit|brain-autopilot|brain-init|brain-onboard|brain-plan|brain-report|whatif)\"",
      "min": 1,
      "weight": 1,
      "arm": "with-only"
    }
  ],
  "difficulty": "hard"
}
