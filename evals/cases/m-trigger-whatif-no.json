{
  "$schema": "plangraph-eval-case/2",
  "id": "m-trigger-whatif-no",
  "kind": "trigger",
  "family": "trigger-whatif",
  "tags": [
    "trigger",
    "synthetic",
    "size-m",
    "should-not-trigger",
    "whatif"
  ],
  "fixture": {
    "size": "M",
    "seed": 7,
    "plangraph": true,
    "overlay": []
  },
  "prompt": "In JavaScript, what happens if I move a const declaration below the first line that uses it?",
  "limits": {
    "max_turns": 10,
    "timeout_s": 240,
    "max_usd": 0.4
