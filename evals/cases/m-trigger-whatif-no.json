  "graders": [
    {
      "id": "rel-hoisting",
      "role": "outcome",
      "type": "regex",
      "target": "last_message",
      "pattern": "hoist|temporal dead zone|ReferenceError",
      "flags": "i",
      "weight": 1,
      "arm": "both"
    },
    {
      "id": "neg-plangraph-not-used",
      "role": "outcome",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "(?:^|[\\s;&|(])plangraph\\s",
      "min": 0,
      "max": 0,
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "neg-skill-not-fired",
      "role": "outcome",
      "type": "tool_used",
      "tool": "Skill",
      "input_match": "\"skill\"\\s*:\\s*\"(?:[\\w-]+:)?(?:plangraph|audit|autopilot|init|onboard|plan|report|whatif|docs-publish)\"",
      "min": 0,
      "max": 0,
      "weight": 3,
      "arm": "both"
    }
  ],
  "difficulty": "medium",
  "expected": {
    "trigger": false,
    "skill": "whatif",
    "job": "reassigning"
  }
