{
  "$schema": "plangraph-eval-case/2",
  "id": "m-trigger-autopilot-no",
  "kind": "trigger",
  "family": "trigger-autopilot",
  "tags": [
    "trigger",
    "synthetic",
    "size-m",
    "should-not-trigger",
    "autopilot"
  ],
  "fixture": {
    "size": "M",
    "seed": 7,
    "plangraph": true,
    "overlay": []
  },
  "prompt": "Give me a one-paragraph generic template for a software product roadmap (no project details).",
  "limits": {
    "max_turns": 10,
    "timeout_s": 240,
    "max_usd": 0.4
  },
  "graders": [
    {
      "id": "rel-roadmap",
      "role": "outcome",
      "type": "regex",
      "target": "last_message",
      "pattern": "roadmap|milestone|phase",
      "flags": "i",
      "weight": 1,
      "arm": "both"
    },
    {
      "id": "neg-plangraph-not-used",
      "role": "outcome",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "(?:^|[\\s;&|(])plangraph\\s",
      "min": 0,
      "max": 0,
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "neg-skill-not-fired",
      "role": "outcome",
      "type": "tool_used",
      "tool": "Skill",
      "input_match": "\"skill\"\\s*:\\s*\"(?:[\\w-]+:)?(?:plangraph|audit|autopilot|init|onboard|plan|report|whatif|docs-publish)\"",
      "min": 0,
      "max": 0,
      "weight": 3,
      "arm": "both"
    }
  ],
  "difficulty": "medium",
  "expected": {
    "trigger": false,
    "skill": "autopilot",
    "job": "planning"
  }
}
