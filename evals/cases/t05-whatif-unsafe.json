{
  "$schema": "brain-eval-case/1",
  "id": "t05-whatif-unsafe",
  "kind": "task",
  "tags": [
    "whatif",
    "safety"
  ],
  "fixture": {
    "size": "M",
    "seed": 7,
    "plant": {
      "kind": "multi_rule_move",
      "key": "T-8",
      "to": "Ben",
      "sprint": 1
    }
  },
  "prompt": "Can T-8 move to Ben in sprint 1? If not, list every distinct rule code it would break (reason codes such as CAPACITY). Do not change any files. Finish with one line: ANSWER: {\"ok\":true|false,\"codes\":[\"CODE\", ...]}",
  "limits": {
    "max_turns": 12,
    "timeout_s": 300,
    "max_usd": 0.6
  },
  "truth": {
    "derive": "whatif",
    "args": {
      "key": "T-8",
      "to": "Ben",
      "sprint": 1
    },
    "value": {
      "ok": false,
      "codes": [
        "CAPACITY",
        "PRODUCER_LATE"
      ]
    }
  },
  "graders": [
    {
      "id": "ans-ok",
      "type": "regex",
      "target": "last_message",
      "pattern": "(?:^|\\n)ANSWER:(?=[^\\n]*\"ok\"\\s*:\\s*false\\b)",
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "ans-codes",
      "type": "regex",
      "target": "last_message",
      "pattern": "(?:^|\\n)ANSWER:(?=[^\\n]*\"codes\"\\s*:\\s*\\[\\s*(?:\"[^\"\\n]*\"\\s*(?:,\\s*)?){2}\\])(?=[^\\n]*\"codes\"\\s*:\\s*\\[[^\\]]*\"CAPACITY\")(?=[^\\n]*\"codes\"\\s*:\\s*\\[[^\\]]*\"PRODUCER_LATE\")",
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "no-edit",
      "type": "tool_used",
      "tool": "Edit",
      "min": 0,
      "max": 0,
      "weight": 2,
      "arm": "both"
    },
    {
      "id": "no-write",
      "type": "tool_used",
      "tool": "Write",
      "min": 0,
      "max": 0,
      "weight": 2,
      "arm": "both"
    },
    {
      "id": "no-write-flag",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "--write",
      "min": 0,
      "max": 0,
      "weight": 2,
      "arm": "both"
    },
    {
      "id": "used-brain",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "\\bbrain\\s",
      "min": 1,
      "weight": 1,
      "arm": "with-only"
    }
  ],
  "difficulty": "medium"
}
