{
  "$schema": "brain-eval-case/2",
  "id": "m-trigger-brain-onboard-yes",
  "kind": "trigger",
  "family": "trigger-brain-onboard",
  "tags": [
    "trigger",
    "synthetic",
    "size-m",
    "should-trigger",
    "brain-onboard"
  ],
  "fixture": {
    "size": "M",
    "seed": 7,
    "brain": true,
    "overlay": []
  },
  "prompt": "We want to bring the rest of our existing backlog under the plan. Before we start: how many tickets and how many people are already in the plan here? Finish with one line: ANSWER: {\"tickets\":<number>,\"people\":<number>}",
  "limits": {
    "max_turns": 10,
    "timeout_s": 240,
    "max_usd": 0.4
  },
  "truth": {
    "derive": "counts",
    "args": {},
    "value": {
      "tickets": 300,
      "people": 4
    }
  },
  "graders": [
    {
      "id": "ans-tickets",
      "role": "outcome",
      "type": "regex",
      "target": "last_message",
      "pattern": "(?:^|\\n)ANSWER:(?=[^\\n]*\"tickets\"\\s*:\\s*300(?![0-9.]))",
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "ans-people",
      "role": "outcome",
      "type": "regex",
      "target": "last_message",
      "pattern": "(?:^|\\n)ANSWER:(?=[^\\n]*\"people\"\\s*:\\s*4(?![0-9.]))",
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "diag-used-brain",
      "role": "diagnostic",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "(?:^|[\\s;&|(])brain\\s",
      "min": 1,
      "weight": 1,
      "arm": "with-only"
    },
    {
      "id": "diag-skill-fired",
      "role": "diagnostic",
      "type": "tool_used",
      "tool": "Skill",
      "input_match": "\"skill\"\\s*:\\s*\"(?:[\\w-]+:)?(?:brain-onboard)\"",
      "min": 1,
      "weight": 1,
      "arm": "with-only"
    }
  ],
  "difficulty": "medium",
  "expected": {
    "trigger": true,
    "skill": "brain-onboard",
    "job": "onboarding"
  }
}
