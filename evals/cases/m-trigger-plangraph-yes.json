{
  "$schema": "plangraph-eval-case/2",
  "id": "m-trigger-plangraph-yes",
  "kind": "trigger",
  "family": "trigger-plangraph",
  "tags": [
    "trigger",
    "synthetic",
    "size-m",
    "should-trigger",
    "plangraph"
  ],
  "fixture": {
    "size": "M",
    "seed": 7,
    "plangraph": true,
    "overlay": []
  },
  "prompt": "Quick one: who has T-133, and which sprint is it planned in? Finish with one line: ANSWER: {\"owner\":\"<name>\",\"sprint\":<number>}",
  "limits": {
    "max_turns": 10,
    "timeout_s": 240,
    "max_usd": 0.4
  },
  "truth": {
    "derive": "lookup",
    "args": {
      "key": "T-133"
    },
    "value": {
      "owner": "Ana",
      "sprint": 4
    }
  },
  "graders": [
    {
      "id": "ans-owner",
      "role": "outcome",
      "type": "regex",
      "target": "last_message",
      "pattern": "(?:^|\\n)ANSWER:(?=[^\\n]*\"owner\"\\s*:\\s*\"Ana\")",
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "ans-sprint",
      "role": "outcome",
      "type": "regex",
      "target": "last_message",
      "pattern": "(?:^|\\n)ANSWER:(?=[^\\n]*\"sprint\"\\s*:\\s*4(?![0-9.]))",
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "diag-used-plangraph",
      "role": "diagnostic",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "(?:^|[\\s;&|(])plangraph\\s",
      "min": 1,
      "weight": 1,
      "arm": "with-only"
    },
    {
      "id": "diag-skill-fired",
      "role": "diagnostic",
      "type": "tool_used",
      "tool": "Skill",
      "input_match": "\"skill\"\\s*:\\s*\"(?:[\\w-]+:)?(?:plangraph)\"",
      "min": 1,
      "weight": 1,
      "arm": "with-only"
    }
  ],
  "difficulty": "medium",
  "expected": {
    "trigger": true,
    "skill": "plangraph"
  }
}
