{
  "$schema": "brain-eval-case/2",
  "id": "m-trigger-near-key-shape",
  "kind": "trigger",
  "family": "trigger-brain",
  "tags": [
    "trigger",
    "synthetic",
    "size-m",
    "should-not-trigger",
    "brain",
    "near-miss"
  ],
  "fixture": {
    "size": "M",
    "seed": 7,
    "brain": true,
    "overlay": []
  },
  "prompt": "Rename the variable T9 to retryCount in this snippet: const T9 = 3; retry(T9);",
  "limits": {
    "max_turns": 10,
    "timeout_s": 240,
    "max_usd": 0.4
  },
  "graders": [
    {
      "id": "rel-near",
      "role": "outcome",
      "type": "regex",
      "target": "last_message",
      "pattern": "retryCount",
      "flags": "i",
      "weight": 1,
      "arm": "both"
    },
    {
      "id": "neg-brain-not-used",
      "role": "outcome",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "(?:^|[\\s;&|(])brain\\s",
      "min": 0,
      "max": 0,
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "neg-skill-not-fired",
      "role": "outcome",
      "type": "tool_used",
      "tool": "Skill",
      "input_match": "\"skill\"\\s*:\\s*\"(?:[\\w-]+:)?(?:brain(?:-[a-z]+)?|whatif)\"",
      "min": 0,
      "max": 0,
      "weight": 3,
      "arm": "both"
    }
  ],
  "difficulty": "medium",
  "expected": {
    "trigger": false,
    "skill": "brain"
  }
}
