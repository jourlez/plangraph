{
  "$schema": "brain-eval-case/1",
  "id": "t08-verdict-histogram",
  "kind": "task",
  "tags": [
    "blockers",
    "findings"
  ],
  "fixture": {
    "size": "M",
    "seed": 7,
    "plant": {
      "kind": "spread_verdicts"
    }
  },
  "prompt": "How many tickets are not READY, split by verdict (NEEDS_INFO and BLOCKED), and which tickets have a missing_ac finding? Do not change any files. Finish with one line: ANSWER: {\"needs_info\":<number>,\"blocked\":<number>,\"missing_ac\":[\"T-1\", ...]}",
  "limits": {
    "max_turns": 12,
    "timeout_s": 300,
    "max_usd": 0.6
  },
  "truth": {
    "derive": "blockers",
    "args": {},
    "value": {
      "needs_info": 18,
      "blocked": 11,
      "missing_ac": [
        "T-8",
        "T-39",
        "T-70",
        "T-101",
        "T-132",
        "T-163",
        "T-194",
        "T-225",
        "T-256",
        "T-287"
      ]
    }
  },
  "graders": [
    {
      "id": "ans-needs-info",
      "type": "regex",
      "target": "last_message",
      "pattern": "(?:^|\\n)ANSWER:(?=[^\\n]*\"needs_info\"\\s*:\\s*18(?![0-9.]))",
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "ans-blocked",
      "type": "regex",
      "target": "last_message",
      "pattern": "(?:^|\\n)ANSWER:(?=[^\\n]*\"blocked\"\\s*:\\s*11(?![0-9.]))",
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "ans-missing-ac",
      "type": "regex",
      "target": "last_message",
      "pattern": "(?:^|\\n)ANSWER:(?=[^\\n]*\"missing_ac\"\\s*:\\s*\\[\\s*(?:\"[^\"\\n]*\"\\s*(?:,\\s*)?){10}\\])(?=[^\\n]*\"missing_ac\"\\s*:\\s*\\[[^\\]]*\"T-8\")(?=[^\\n]*\"missing_ac\"\\s*:\\s*\\[[^\\]]*\"T-39\")(?=[^\\n]*\"missing_ac\"\\s*:\\s*\\[[^\\]]*\"T-70\")(?=[^\\n]*\"missing_ac\"\\s*:\\s*\\[[^\\]]*\"T-101\")(?=[^\\n]*\"missing_ac\"\\s*:\\s*\\[[^\\]]*\"T-132\")(?=[^\\n]*\"missing_ac\"\\s*:\\s*\\[[^\\]]*\"T-163\")(?=[^\\n]*\"missing_ac\"\\s*:\\s*\\[[^\\]]*\"T-194\")(?=[^\\n]*\"missing_ac\"\\s*:\\s*\\[[^\\]]*\"T-225\")(?=[^\\n]*\"missing_ac\"\\s*:\\s*\\[[^\\]]*\"T-256\")(?=[^\\n]*\"missing_ac\"\\s*:\\s*\\[[^\\]]*\"T-287\")",
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "no-edit",
      "type": "tool_used",
      "tool": "Edit",
      "min": 0,
      "max": 0,
      "weight": 2,
      "arm": "both"
    },
    {
      "id": "no-write",
      "type": "tool_used",
      "tool": "Write",
      "min": 0,
      "max": 0,
      "weight": 2,
      "arm": "both"
    },
    {
      "id": "no-write-flag",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "--write",
      "min": 0,
      "max": 0,
      "weight": 2,
      "arm": "both"
    },
    {
      "id": "used-brain",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "\\bbrain\\s",
      "min": 1,
      "weight": 1,
      "arm": "with-only"
    }
  ],
  "difficulty": "medium"
}
