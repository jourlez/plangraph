{
  "$schema": "brain-eval-case/1",
  "id": "t10-stale-audits",
  "kind": "task",
  "tags": [
    "stale"
  ],
  "fixture": {
    "size": "M",
    "seed": 7,
    "plant": {
      "kind": "edited_plan_sections",
      "edited": [
        "T-286",
        "T-298",
        "T-299",
        "T-300"
      ]
    }
  },
  "prompt": "The task text of some tickets in plan.md was edited after their last audit, and tickets that need them are affected too. Which tickets' audit verdicts are stale (use brain stale against HEAD)? Do not re-audit and do not change any files. Finish with one line: ANSWER: {\"stale\":[\"T-1\", ...],\"edited\":[\"T-1\", ...],\"count\":<number>} where edited are the tickets whose own plan text changed.",
  "limits": {
    "max_turns": 14,
    "timeout_s": 300,
    "max_usd": 0.6
  },
  "truth": {
    "derive": "computeStale",
    "args": {
      "ref": "HEAD"
    },
    "value": {
      "stale": [
        "T-286",
        "T-290",
        "T-298",
        "T-299",
        "T-300"
      ],
      "edited": [
        "T-286",
        "T-298",
        "T-299",
        "T-300"
      ],
      "count": 5
    }
  },
  "graders": [
    {
      "id": "ans-stale",
      "type": "regex",
      "target": "last_message",
      "pattern": "(?:^|\\n)ANSWER:(?=[^\\n]*\"stale\"\\s*:\\s*\\[\\s*(?:\"[^\"\\n]*\"\\s*(?:,\\s*)?){5}\\])(?=[^\\n]*\"stale\"\\s*:\\s*\\[[^\\]]*\"T-286\")(?=[^\\n]*\"stale\"\\s*:\\s*\\[[^\\]]*\"T-290\")(?=[^\\n]*\"stale\"\\s*:\\s*\\[[^\\]]*\"T-298\")(?=[^\\n]*\"stale\"\\s*:\\s*\\[[^\\]]*\"T-299\")(?=[^\\n]*\"stale\"\\s*:\\s*\\[[^\\]]*\"T-300\")",
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "ans-edited",
      "type": "regex",
      "target": "last_message",
      "pattern": "(?:^|\\n)ANSWER:(?=[^\\n]*\"edited\"\\s*:\\s*\\[\\s*(?:\"[^\"\\n]*\"\\s*(?:,\\s*)?){4}\\])(?=[^\\n]*\"edited\"\\s*:\\s*\\[[^\\]]*\"T-286\")(?=[^\\n]*\"edited\"\\s*:\\s*\\[[^\\]]*\"T-298\")(?=[^\\n]*\"edited\"\\s*:\\s*\\[[^\\]]*\"T-299\")(?=[^\\n]*\"edited\"\\s*:\\s*\\[[^\\]]*\"T-300\")",
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "ans-count",
      "type": "regex",
      "target": "last_message",
      "pattern": "(?:^|\\n)ANSWER:(?=[^\\n]*\"count\"\\s*:\\s*5(?![0-9.]))",
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "no-edit",
      "type": "tool_used",
      "tool": "Edit",
      "min": 0,
      "max": 0,
      "weight": 2,
      "arm": "both"
    },
    {
      "id": "no-write",
      "type": "tool_used",
      "tool": "Write",
      "min": 0,
      "max": 0,
      "weight": 2,
      "arm": "both"
    },
    {
      "id": "no-write-flag",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "--write",
      "min": 0,
      "max": 0,
      "weight": 2,
      "arm": "both"
    },
    {
      "id": "used-brain",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "\\bbrain\\s",
      "min": 1,
      "weight": 1,
      "arm": "with-only"
    }
  ],
  "difficulty": "hard"
}
