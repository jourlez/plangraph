{
  "$schema": "brain-eval-case/2",
  "id": "m-trigger-brain-onboard-no",
  "kind": "trigger",
  "family": "trigger-brain-onboard",
  "tags": [
    "trigger",
    "synthetic",
    "size-m",
    "should-not-trigger",
    "brain-onboard"
  ],
  "fixture": {
    "size": "M",
    "seed": 7,
    "brain": true,
    "overlay": []
  },
  "prompt": "Onboard me to git: which five commands will I use every day?",
  "limits": {
    "max_turns": 10,
    "timeout_s": 240,
    "max_usd": 0.4
  },
  "graders": [
    {
      "id": "rel-git",
      "role": "outcome",
      "type": "regex",
      "target": "last_message",
      "pattern": "git (?:status|add|commit|pull|push)",
      "flags": "i",
      "weight": 1,
      "arm": "both"
    },
    {
      "id": "neg-brain-not-used",
      "role": "outcome",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "(?:^|[\\s;&|(])brain\\s",
      "min": 0,
      "max": 0,
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "neg-skill-not-fired",
      "role": "outcome",
      "type": "tool_used",
      "tool": "Skill",
      "input_match": "\"skill\"\\s*:\\s*\"(?:[\\w-]+:)?(?:brain(?:-[a-z]+)?|whatif)\"",
      "min": 0,
      "max": 0,
      "weight": 3,
      "arm": "both"
    }
  ],
  "difficulty": "medium",
  "expected": {
    "trigger": false,
    "skill": "brain-onboard",
    "job": "onboarding"
  }
}
