{
  "$schema": "brain-eval-case/1",
  "id": "t06-replan-minimal",
  "kind": "task",
  "tags": [
    "replan",
    "whatif",
    "read-only"
  ],
  "fixture": {
    "size": "M",
    "seed": 7,
    "plant": {
      "kind": "ripple",
      "key": "T-55",
      "to": "Ana",
      "sprint": 4
    }
  },
  "prompt": "Reassign T-55 to Ana in sprint 4 and tell me the smallest set of OTHER tickets that must shift so the plan stays valid. Do not apply it and do not change any files. Finish with one line: ANSWER: {\"moved\":[\"T-1\", ...]}",
  "limits": {
    "max_turns": 16,
    "timeout_s": 300,
    "max_usd": 0.8
  },
  "truth": {
    "derive": "proposeMove",
    "args": {
      "key": "T-55",
      "to": "Ana",
      "sprint": 4
    },
    "value": {
      "moved": [
        "T-102",
        "T-167",
        "T-198",
        "T-251"
      ]
    }
  },
  "graders": [
    {
      "id": "ans-moved",
      "type": "regex",
      "target": "last_message",
      "pattern": "(?:^|\\n)ANSWER:(?=[^\\n]*\"moved\"\\s*:\\s*\\[\\s*(?:\"[^\"\\n]*\"\\s*(?:,\\s*)?){4}\\])(?=[^\\n]*\"moved\"\\s*:\\s*\\[[^\\]]*\"T-102\")(?=[^\\n]*\"moved\"\\s*:\\s*\\[[^\\]]*\"T-167\")(?=[^\\n]*\"moved\"\\s*:\\s*\\[[^\\]]*\"T-198\")(?=[^\\n]*\"moved\"\\s*:\\s*\\[[^\\]]*\"T-251\")",
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "no-edit",
      "type": "tool_used",
      "tool": "Edit",
      "min": 0,
      "max": 0,
      "weight": 2,
      "arm": "both"
    },
    {
      "id": "no-write",
      "type": "tool_used",
      "tool": "Write",
      "min": 0,
      "max": 0,
      "weight": 2,
      "arm": "both"
    },
    {
      "id": "no-write-flag",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "--write",
      "min": 0,
      "max": 0,
      "weight": 2,
      "arm": "both"
    },
    {
      "id": "used-brain",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "\\bbrain\\s",
      "min": 1,
      "weight": 1,
      "arm": "with-only"
    }
  ],
  "difficulty": "hard"
}
