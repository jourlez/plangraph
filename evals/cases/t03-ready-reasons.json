{
  "$schema": "brain-eval-case/1",
  "id": "t03-ready-reasons",
  "kind": "task",
  "tags": [
    "ready"
  ],
  "fixture": {
    "size": "M",
    "seed": 7,
    "plant": {
      "kind": "needs_info_open_finding_unfinished_producer",
      "key": "T-101"
    }
  },
  "prompt": "May T-101 start now? Give every reason it may not: its readiness verdict, its open finding kinds and its producers that are not Done. Do not change any files. Finish with one line: ANSWER: {\"ok\":false,\"verdict\":\"<verdict>\",\"findings\":[\"<kind>\"],\"unfinished\":[\"T-1\"]}",
  "limits": {
    "max_turns": 12,
    "timeout_s": 300,
    "max_usd": 0.6
  },
  "truth": {
    "derive": "ready",
    "args": {
      "key": "T-101"
    },
    "value": {
      "ok": false,
      "verdict": "NEEDS_INFO",
      "findings": [
        "missing_ac"
      ],
      "unfinished": [
        "T-2"
      ]
    }
  },
  "graders": [
    {
      "id": "ans-ok",
      "type": "regex",
      "target": "last_message",
      "pattern": "(?:^|\\n)ANSWER:(?=[^\\n]*\"ok\"\\s*:\\s*false\\b)",
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "ans-verdict",
      "type": "regex",
      "target": "last_message",
      "pattern": "(?:^|\\n)ANSWER:(?=[^\\n]*\"verdict\"\\s*:\\s*\"NEEDS_INFO\")",
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "ans-findings",
      "type": "regex",
      "target": "last_message",
      "pattern": "(?:^|\\n)ANSWER:(?=[^\\n]*\"findings\"\\s*:\\s*\\[\\s*(?:\"[^\"\\n]*\"\\s*(?:,\\s*)?){1}\\])(?=[^\\n]*\"findings\"\\s*:\\s*\\[[^\\]]*\"missing_ac\")",
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "ans-unfinished",
      "type": "regex",
      "target": "last_message",
      "pattern": "(?:^|\\n)ANSWER:(?=[^\\n]*\"unfinished\"\\s*:\\s*\\[\\s*(?:\"[^\"\\n]*\"\\s*(?:,\\s*)?){1}\\])(?=[^\\n]*\"unfinished\"\\s*:\\s*\\[[^\\]]*\"T-2\")",
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "no-edit",
      "type": "tool_used",
      "tool": "Edit",
      "min": 0,
      "max": 0,
      "weight": 2,
      "arm": "both"
    },
    {
      "id": "no-write",
      "type": "tool_used",
      "tool": "Write",
      "min": 0,
      "max": 0,
      "weight": 2,
      "arm": "both"
    },
    {
      "id": "no-write-flag",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "--write",
      "min": 0,
      "max": 0,
      "weight": 2,
      "arm": "both"
    },
    {
      "id": "used-brain",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "\\bbrain\\s",
      "min": 1,
      "weight": 1,
      "arm": "with-only"
    }
  ],
  "difficulty": "medium"
}
