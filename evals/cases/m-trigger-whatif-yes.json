{
  "$schema": "brain-eval-case/2",
  "id": "m-trigger-whatif-yes",
  "kind": "trigger",
  "family": "trigger-whatif",
  "tags": [
    "trigger",
    "synthetic",
    "size-m",
    "should-trigger",
    "whatif"
  ],
  "fixture": {
    "size": "M",
    "seed": 7,
    "brain": true,
    "overlay": []
  },
  "prompt": "What would break if T-185 went to Ana in sprint 2 instead? Finish with one line: ANSWER: {\"ok\":true|false,\"codes\":[\"<rule code>\", ...]} using codes PRODUCER_LATE, CONSUMER_EARLY, CAPACITY, OUT_OF_RANGE, STARTED.",
  "limits": {
    "max_turns": 10,
    "timeout_s": 240,
    "max_usd": 0.4
  },
  "truth": {
    "derive": "whatif",
    "args": {
      "key": "T-185",
      "to": "Ana",
      "sprint": 2
    },
    "value": {
      "ok": false,
      "codes": [
        "PRODUCER_LATE"
      ]
    }
  },
  "graders": [
    {
      "id": "ans-ok",
      "role": "outcome",
      "type": "regex",
      "target": "last_message",
      "pattern": "(?:^|\\n)ANSWER:(?=[^\\n]*\"ok\"\\s*:\\s*false\\b)",
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "ans-codes",
      "role": "outcome",
      "type": "regex",
      "target": "last_message",
      "pattern": "(?:^|\\n)ANSWER:(?=[^\\n]*\"codes\"\\s*:\\s*\\[\\s*(?:\"[^\"\\n]*\"\\s*(?:,\\s*)?){1}\\])(?=[^\\n]*\"codes\"\\s*:\\s*\\[[^\\]\\n]*\"PRODUCER_LATE\")",
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "diag-used-brain",
      "role": "diagnostic",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "(?:^|[\\s;&|(])brain\\s",
      "min": 1,
      "weight": 1,
      "arm": "with-only"
    },
    {
      "id": "diag-skill-fired",
      "role": "diagnostic",
      "type": "tool_used",
      "tool": "Skill",
      "input_match": "\"skill\"\\s*:\\s*\"(?:[\\w-]+:)?(?:whatif)\"",
      "min": 1,
      "weight": 1,
      "arm": "with-only"
    }
  ],
  "difficulty": "medium",
  "expected": {
    "trigger": true,
    "skill": "whatif",
    "job": "reassigning"
  }
}
