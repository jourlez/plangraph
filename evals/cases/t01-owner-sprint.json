{
  "$schema": "brain-eval-case/1",
  "id": "t01-owner-sprint",
  "kind": "task",
  "tags": [
    "lookup",
    "control"
  ],
  "fixture": {
    "size": "M",
    "seed": 7,
    "plant": {
      "kind": "none"
    }
  },
  "prompt": "Who owns T-137 and in which sprint? Do not change any files. Finish with one line: ANSWER: {\"owner\":\"<name>\",\"sprint\":<number>}",
  "limits": {
    "max_turns": 12,
    "timeout_s": 300,
    "max_usd": 0.6
  },
  "truth": {
    "derive": "lookup",
    "args": {
      "key": "T-137"
    },
    "value": {
      "owner": "Cleo",
      "sprint": 3
    }
  },
  "graders": [
    {
      "id": "ans-owner",
      "type": "regex",
      "target": "last_message",
      "pattern": "(?:^|\\n)ANSWER:(?=[^\\n]*\"owner\"\\s*:\\s*\"Cleo\")",
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "ans-sprint",
      "type": "regex",
      "target": "last_message",
      "pattern": "(?:^|\\n)ANSWER:(?=[^\\n]*\"sprint\"\\s*:\\s*3(?![0-9.]))",
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "no-edit",
      "type": "tool_used",
      "tool": "Edit",
      "min": 0,
      "max": 0,
      "weight": 2,
      "arm": "both"
    },
    {
      "id": "no-write",
      "type": "tool_used",
      "tool": "Write",
      "min": 0,
      "max": 0,
      "weight": 2,
      "arm": "both"
    },
    {
      "id": "no-write-flag",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "--write",
      "min": 0,
      "max": 0,
      "weight": 2,
      "arm": "both"
    },
    {
      "id": "used-brain",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "\\bbrain\\s",
      "min": 1,
      "weight": 1,
      "arm": "with-only"
    }
  ],
  "difficulty": "easy"
}
