{
  "$schema": "brain-eval-case/1",
  "id": "t02-direct-needs",
  "kind": "task",
  "tags": [
    "neighbors"
  ],
  "fixture": {
    "size": "M",
    "seed": 7,
    "plant": {
      "kind": "none"
    }
  },
  "prompt": "List the tickets T-67 directly needs (its producers only, not the tickets that need it), each with its owner and sprint. Do not change any files. Finish with one line: ANSWER: {\"needs\":[\"T-1 Ana S1\", ...]} using the format \"<key> <owner> S<sprint>\".",
  "limits": {
    "max_turns": 12,
    "timeout_s": 300,
    "max_usd": 0.6
  },
  "truth": {
    "derive": "neighbors",
    "args": {
      "key": "T-67"
    },
    "value": {
      "needs": [
        "T-5 Ana S1",
        "T-43 Cleo S3",
        "T-57 Ben S3"
      ]
    }
  },
  "graders": [
    {
      "id": "ans-needs",
      "type": "regex",
      "target": "last_message",
      "pattern": "(?:^|\\n)ANSWER:(?=[^\\n]*\"needs\"\\s*:\\s*\\[\\s*(?:\"[^\"\\n]*\"\\s*(?:,\\s*)?){3}\\])(?=[^\\n]*\"needs\"\\s*:\\s*\\[[^\\]]*\"T-5 Ana S1\")(?=[^\\n]*\"needs\"\\s*:\\s*\\[[^\\]]*\"T-43 Cleo S3\")(?=[^\\n]*\"needs\"\\s*:\\s*\\[[^\\]]*\"T-57 Ben S3\")",
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "no-edit",
      "type": "tool_used",
      "tool": "Edit",
      "min": 0,
      "max": 0,
      "weight": 2,
      "arm": "both"
    },
    {
      "id": "no-write",
      "type": "tool_used",
      "tool": "Write",
      "min": 0,
      "max": 0,
      "weight": 2,
      "arm": "both"
    },
    {
      "id": "no-write-flag",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "--write",
      "min": 0,
      "max": 0,
      "weight": 2,
      "arm": "both"
    },
    {
      "id": "used-brain",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "\\bbrain\\s",
      "min": 1,
      "weight": 1,
      "arm": "with-only"
    },
    {
      "id": "no-consumers",
      "type": "regex",
      "target": "last_message",
      "pattern": "^(?![\\s\\S]*?(?:^|\\n)ANSWER:[^\\n]*\\b(?:T-79|T-81|T-198)\\b)",
      "weight": 2,
      "arm": "both"
    }
  ],
  "difficulty": "medium"
}
