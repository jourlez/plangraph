{
  "$schema": "brain-eval-case/1",
  "id": "t04-chain-hops",
  "kind": "task",
  "tags": [
    "chain"
  ],
  "fixture": {
    "size": "M",
    "seed": 7,
    "plant": {
      "kind": "none"
    }
  },
  "prompt": "How many hops is the longest dependency chain behind T-265? (A hop is one producer link.) Do not change any files. Finish with one line: ANSWER: {\"hops\":<number>}",
  "limits": {
    "max_turns": 12,
    "timeout_s": 300,
    "max_usd": 0.6
  },
  "truth": {
    "derive": "chain",
    "args": {
      "key": "T-265"
    },
    "value": {
      "hops": 10
    }
  },
  "graders": [
    {
      "id": "ans-hops",
      "type": "regex",
      "target": "last_message",
      "pattern": "(?:^|\\n)ANSWER:(?=[^\\n]*\"hops\"\\s*:\\s*10(?![0-9.]))",
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "no-edit",
      "type": "tool_used",
      "tool": "Edit",
      "min": 0,
      "max": 0,
      "weight": 2,
      "arm": "both"
    },
    {
      "id": "no-write",
      "type": "tool_used",
      "tool": "Write",
      "min": 0,
      "max": 0,
      "weight": 2,
      "arm": "both"
    },
    {
      "id": "no-write-flag",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "--write",
      "min": 0,
      "max": 0,
      "weight": 2,
      "arm": "both"
    },
    {
      "id": "used-brain",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "\\bbrain\\s",
      "min": 1,
      "weight": 1,
      "arm": "with-only"
    }
  ],
  "difficulty": "medium"
}
