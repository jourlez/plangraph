{
  "$schema": "brain-eval-case/1",
  "id": "t09-what-to-start",
  "kind": "task",
  "tags": [
    "decide"
  ],
  "fixture": {
    "size": "M",
    "seed": 7,
    "plant": {
      "kind": "decoy_with_unfinished_producer",
      "owner": "Cleo",
      "sprint": 6,
      "decoy": "T-85"
    }
  },
  "prompt": "Cleo has capacity in sprint 6. Which ticket should Cleo start? Rule: a READY ticket Cleo owns in sprint 6, every producer Done, not itself Done, that directly unblocks the most tickets; tie: lowest key. Do not change any files. Finish with one line: ANSWER: {\"key\":\"T-1\"}",
  "limits": {
    "max_turns": 12,
    "timeout_s": 300,
    "max_usd": 0.6
  },
  "truth": {
    "derive": "decide",
    "args": {
      "owner": "Cleo",
      "sprint": 6
    },
    "value": {
      "key": "T-188"
    }
  },
  "graders": [
    {
      "id": "ans-key",
      "type": "regex",
      "target": "last_message",
      "pattern": "(?:^|\\n)ANSWER:(?=[^\\n]*\"key\"\\s*:\\s*\"T-188\")",
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "no-edit",
      "type": "tool_used",
      "tool": "Edit",
      "min": 0,
      "max": 0,
      "weight": 2,
      "arm": "both"
    },
    {
      "id": "no-write",
      "type": "tool_used",
      "tool": "Write",
      "min": 0,
      "max": 0,
      "weight": 2,
      "arm": "both"
    },
    {
      "id": "no-write-flag",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "--write",
      "min": 0,
      "max": 0,
      "weight": 2,
      "arm": "both"
    },
    {
      "id": "used-brain",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "\\bbrain\\s",
      "min": 1,
      "weight": 1,
      "arm": "with-only"
    },
    {
      "id": "no-decoy",
      "type": "regex",
      "target": "last_message",
      "pattern": "^(?![\\s\\S]*?(?:^|\\n)ANSWER:[^\\n]*\\bT-85\\b)",
      "weight": 2,
      "arm": "both"
    }
  ],
  "difficulty": "hard"
}
