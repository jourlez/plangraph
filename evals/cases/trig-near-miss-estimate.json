{
  "$schema": "brain-eval-case/1",
  "id": "trig-near-miss-estimate",
  "kind": "trigger",
  "tags": [
    "trigger",
    "should-not-trigger",
    "planning"
  ],
  "fixture": {
    "size": "M",
    "seed": 7
  },
  "prompt": "Estimate story points for this change: I added retry logic to the payment webhook handler and two tests.",
  "limits": {
    "max_turns": 8,
    "timeout_s": 180,
    "max_usd": 0.3
  },
  "expected": {
    "trigger": false,
    "job": "planning"
  },
  "graders": [
    {
      "id": "brain-not-used",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "\\bbrain\\s",
      "min": 0,
      "max": 0,
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "skill-not-fired",
      "type": "tool_used",
      "tool": "Skill",
      "input_match": "\"skill\"\\s*:\\s*\"(?:[\\w-]+:)?brain(?:-[a-z]+)?\"",
      "min": 0,
      "max": 0,
      "weight": 3,
      "arm": "both"
    }
  ]
}
