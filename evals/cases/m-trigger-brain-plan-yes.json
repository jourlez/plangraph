{
  "$schema": "brain-eval-case/2",
  "id": "m-trigger-brain-plan-yes",
  "kind": "trigger",
  "family": "trigger-brain-plan",
  "tags": [
    "trigger",
    "synthetic",
    "size-m",
    "should-trigger",
    "brain-plan"
  ],
  "fixture": {
    "size": "M",
    "seed": 7,
    "brain": true,
    "overlay": []
  },
  "prompt": "We are adding a new 5-point ticket for Dan to the plan. What is the earliest sprint where Dan still has room for 5 more points? Finish with one line: ANSWER: {\"sprint\":<number>}",
  "limits": {
    "max_turns": 10,
    "timeout_s": 240,
    "max_usd": 0.4
  },
  "truth": {
    "derive": "loads",
    "args": {
      "person": "Dan",
      "sp": 5
    },
    "value": {
      "sprint": 4
    }
  },
  "graders": [
    {
      "id": "ans-sprint",
      "role": "outcome",
      "type": "regex",
      "target": "last_message",
      "pattern": "(?:^|\\n)ANSWER:(?=[^\\n]*\"sprint\"\\s*:\\s*4(?![0-9.]))",
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "diag-used-brain",
      "role": "diagnostic",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "(?:^|[\\s;&|(])brain\\s",
      "min": 1,
      "weight": 1,
      "arm": "with-only"
    },
    {
      "id": "diag-skill-fired",
      "role": "diagnostic",
      "type": "tool_used",
      "tool": "Skill",
      "input_match": "\"skill\"\\s*:\\s*\"(?:[\\w-]+:)?(?:brain-plan)\"",
      "min": 1,
      "weight": 1,
      "arm": "with-only"
    }
  ],
  "difficulty": "medium",
  "expected": {
    "trigger": true,
    "skill": "brain-plan",
    "job": "planning"
  }
}
