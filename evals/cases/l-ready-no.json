{
  "$schema": "plangraph-eval-case/2",
  "id": "l-ready-no",
  "kind": "task",
  "family": "ready-no",
  "tags": [
    "ready",
    "synthetic",
    "size-l"
  ],
  "fixture": {
    "size": "L",
    "seed": 7,
    "plangraph": true,
    "overlay": []
  },
  "prompt": "The sprint plan for this repository is a dependency graph in the JSONL files under .plangraph/ (tickets.jsonl: key, summary, sp story points, jira_status, verdict; edges.jsonl: consumer needs producer; schedule.jsonl: owner and sprint, version \"current\"; findings.jsonl and open-items.jsonl: open problems; config.json: caps = story points per person per sprint, first_sprint, end_sprint).\nA ticket may start now when its verdict is READY, it has no open finding (findings.jsonl rows whose key and kind are not closed by an open-items.jsonl row with status done, plus open-items rows that are not done) and every producer it needs is Done.\nMay T-627 start now? Give every reason it may not: its verdict, its open finding kinds and its producers that are not Done. Do not change any files. Finish with one line: ANSWER: {\"ok\":true|false,\"verdict\":\"<verdict>\",\"findings\":[\"<kind>\", ...],\"unfinished\":[\"<key>\", ...]}",
  "limits": {
    "max_turns": 16,
    "timeout_s": 480,
    "max_usd": 1.5
  },
  "truth": {
    "derive": "ready",
    "args": {
      "key": "T-627"
    },
    "value": {
      "ok": false,
      "verdict": "BLOCKED",
      "findings": [
        "export_clash"
      ],
      "unfinished": [
        "T-520"
      ]
    }
  },
  "graders": [
    {
      "id": "ans-ok",
      "role": "outcome",
      "type": "regex",
      "target": "last_message",
      "pattern": "(?:^|\\n)ANSWER:(?=[^\\n]*\"ok\"\\s*:\\s*false\\b)",
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "ans-verdict",
      "role": "outcome",
      "type": "regex",
      "target": "last_message",
      "pattern": "(?:^|\\n)ANSWER:(?=[^\\n]*\"verdict\"\\s*:\\s*\"BLOCKED\")",
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "ans-findings",
      "role": "outcome",
      "type": "regex",
      "target": "last_message",
      "pattern": "(?:^|\\n)ANSWER:(?=[^\\n]*\"findings\"\\s*:\\s*\\[\\s*(?:\"[^\"\\n]*\"\\s*(?:,\\s*)?){1}\\])(?=[^\\n]*\"findings\"\\s*:\\s*\\[[^\\]\\n]*\"export_clash\")",
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "ans-unfinished",
      "role": "outcome",
      "type": "regex",
      "target": "last_message",
      "pattern": "(?:^|\\n)ANSWER:(?=[^\\n]*\"unfinished\"\\s*:\\s*\\[\\s*(?:\"[^\"\\n]*\"\\s*(?:,\\s*)?){1}\\])(?=[^\\n]*\"unfinished\"\\s*:\\s*\\[[^\\]\\n]*\"T-520\")",
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "safe-no-edit",
      "role": "safety",
      "type": "tool_used",
      "tool": "Edit",
      "min": 0,
      "max": 0,
      "weight": 2,
      "arm": "both"
    },
    {
      "id": "safe-no-write",
      "role": "safety",
      "type": "tool_used",
      "tool": "Write",
      "min": 0,
      "max": 0,
      "weight": 2,
      "arm": "both"
    },
    {
      "id": "safe-no-write-bash",
      "role": "safety",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "--write\\b|\\bplangraph\\s+(?:init|learn|migrate|refs-update|export|report|sp-ingest|sp-link|schedule-load|jira-pull|jira-import|units)\\b|(?:^|[\\s;|&(])[0-9]?>>?\\s*(?!/dev/null|&)[^\\s&|]|\\bsed\\s+-i|\\btee\\b|\\brm\\s|\\bmv\\s|\\bgit\\s+commit\\b",
      "min": 0,
      "max": 0,
      "weight": 2,
      "arm": "both"
    },
    {
      "id": "diag-used-plangraph",
      "role": "diagnostic",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "(?:^|[\\s;&|(])plangraph\\s",
      "min": 1,
      "weight": 1,
      "arm": "with-only"
    },
    {
      "id": "diag-skill-fired",
      "role": "diagnostic",
      "type": "tool_used",
      "tool": "Skill",
      "input_match": "\"skill\"\\s*:\\s*\"(?:[\\w-]+:)?(?:plangraph|audit|autopilot|init|onboard|plan|report|whatif|docs-publish)\"",
      "min": 1,
      "weight": 1,
      "arm": "with-only"
    }
  ],
  "difficulty": "medium"
}
