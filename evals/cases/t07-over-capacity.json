{
  "$schema": "brain-eval-case/1",
  "id": "t07-over-capacity",
  "kind": "task",
  "tags": [
    "aggregate"
  ],
  "fixture": {
    "size": "M",
    "seed": 7,
    "plant": {
      "kind": "tight_person",
      "person": "Cleo",
      "cap": 10
    }
  },
  "prompt": "Which person-sprints are over capacity (sum of story points above the person's capacity)? Name the worst one: the largest excess, ties by lowest sprint then name. Do not change any files. Finish with one line: ANSWER: {\"over\":[\"Ana S3\", ...],\"worst\":\"<name> S<sprint>\",\"count\":<number>}",
  "limits": {
    "max_turns": 12,
    "timeout_s": 300,
    "max_usd": 0.6
  },
  "truth": {
    "derive": "verifyPlan",
    "args": {},
    "value": {
      "over": [
        "Ana S1",
        "Ben S1",
        "Ben S2",
        "Ben S4",
        "Cleo S1",
        "Cleo S2",
        "Cleo S3",
        "Cleo S4",
        "Cleo S5",
        "Cleo S6",
        "Dan S1"
      ],
      "worst": "Cleo S1",
      "count": 11
    }
  },
  "graders": [
    {
      "id": "ans-over",
      "type": "regex",
      "target": "last_message",
      "pattern": "(?:^|\\n)ANSWER:(?=[^\\n]*\"over\"\\s*:\\s*\\[\\s*(?:\"[^\"\\n]*\"\\s*(?:,\\s*)?){11}\\])(?=[^\\n]*\"over\"\\s*:\\s*\\[[^\\]]*\"Ana S1\")(?=[^\\n]*\"over\"\\s*:\\s*\\[[^\\]]*\"Ben S1\")(?=[^\\n]*\"over\"\\s*:\\s*\\[[^\\]]*\"Ben S2\")(?=[^\\n]*\"over\"\\s*:\\s*\\[[^\\]]*\"Ben S4\")(?=[^\\n]*\"over\"\\s*:\\s*\\[[^\\]]*\"Cleo S1\")(?=[^\\n]*\"over\"\\s*:\\s*\\[[^\\]]*\"Cleo S2\")(?=[^\\n]*\"over\"\\s*:\\s*\\[[^\\]]*\"Cleo S3\")(?=[^\\n]*\"over\"\\s*:\\s*\\[[^\\]]*\"Cleo S4\")(?=[^\\n]*\"over\"\\s*:\\s*\\[[^\\]]*\"Cleo S5\")(?=[^\\n]*\"over\"\\s*:\\s*\\[[^\\]]*\"Cleo S6\")(?=[^\\n]*\"over\"\\s*:\\s*\\[[^\\]]*\"Dan S1\")",
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "ans-worst",
      "type": "regex",
      "target": "last_message",
      "pattern": "(?:^|\\n)ANSWER:(?=[^\\n]*\"worst\"\\s*:\\s*\"Cleo S1\")",
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "ans-count",
      "type": "regex",
      "target": "last_message",
      "pattern": "(?:^|\\n)ANSWER:(?=[^\\n]*\"count\"\\s*:\\s*11(?![0-9.]))",
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "no-edit",
      "type": "tool_used",
      "tool": "Edit",
      "min": 0,
      "max": 0,
      "weight": 2,
      "arm": "both"
    },
    {
      "id": "no-write",
      "type": "tool_used",
      "tool": "Write",
      "min": 0,
      "max": 0,
      "weight": 2,
      "arm": "both"
    },
    {
      "id": "no-write-flag",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "--write",
      "min": 0,
      "max": 0,
      "weight": 2,
      "arm": "both"
    },
    {
      "id": "used-brain",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "\\bbrain\\s",
      "min": 1,
      "weight": 1,
      "arm": "with-only"
    }
  ],
  "difficulty": "medium"
}
