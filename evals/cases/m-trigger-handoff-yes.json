{
  "$schema": "brain-eval-case/2",
  "id": "m-trigger-handoff-yes",
  "kind": "trigger",
  "family": "trigger-handoff",
  "tags": [
    "trigger",
    "synthetic",
    "size-m",
    "should-trigger",
    "brain"
  ],
  "fixture": {
    "size": "M",
    "seed": 7,
    "brain": true,
    "overlay": []
  },
  "prompt": "Wrap up the session and hand off the plan state to the next person: how many tickets are not READY, and how many audit verdicts are stale because the plan text changed? Do not change anything. Finish with one line: ANSWER: {\"not_ready\":<number>,\"stale\":<number>}",
  "limits": {
    "max_turns": 14,
    "timeout_s": 300,
    "max_usd": 0.6
  },
  "truth": {
    "derive": "blockers+computeStale",
    "args": {},
    "value": {
      "not_ready": 27,
      "stale": 5
    }
  },
  "graders": [
    {
      "id": "ans-not-ready",
      "role": "outcome",
      "type": "regex",
      "target": "last_message",
      "pattern": "(?:^|\\n)ANSWER:(?=[^\\n]*\"not_ready\"\\s*:\\s*27(?![0-9.]))",
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "ans-stale",
      "role": "outcome",
      "type": "regex",
      "target": "last_message",
      "pattern": "(?:^|\\n)ANSWER:(?=[^\\n]*\"stale\"\\s*:\\s*5(?![0-9.]))",
      "weight": 3,
      "arm": "both"
    },
    {
      "id": "diag-used-brain",
      "role": "diagnostic",
      "type": "tool_used",
      "tool": "Bash",
      "input_match": "(?:^|[\\s;&|(])brain\\s",
      "min": 1,
      "weight": 1,
      "arm": "with-only"
    },
    {
      "id": "diag-skill-fired",
      "role": "diagnostic",
      "type": "tool_used",
      "tool": "Skill",
      "input_match": "\"skill\"\\s*:\\s*\"(?:[\\w-]+:)?(?:brain)\"",
      "min": 1,
      "weight": 1,
      "arm": "with-only"
    }
  ],
  "difficulty": "medium",
  "expected": {
    "trigger": true,
    "skill": "brain",
    "job": "handoff"
  }
}
