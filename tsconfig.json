{
  "compilerOptions": {
    "target": "es2024",
    "lib": [
      "es2024",
      "esnext.iterator",
      "esnext.disposable",
      "esnext.collection"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "exactOptionalPropertyTypes": true
  },
  "include": [
    "**/*.ts",
    "src/floor.js"
  ],
  "exclude": [
    "node_modules",
    "test/types-fixtures"
  ]
}
