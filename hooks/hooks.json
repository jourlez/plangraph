{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/src/entry.js", "card", "--if-present", "--refresh"], "timeout": 10 }
        ]
      }
    ]
  }
}
